{
  "kind": "singleType",
  "collectionName": "footers",
  "info": {
    "singularName": "footer",
    "pluralName": "footers",
    "displayName": "Global: Footer",
    "description": "Site footer with contact info and links"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "address": {
      "type": "text"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "columns": {
      "type": "component",
      "repeatable": true,
      "component": "shared.footer-column"
    },
    "socials": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "legalLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    },
    "copyright": {
      "type": "string"
    }
  }
}
