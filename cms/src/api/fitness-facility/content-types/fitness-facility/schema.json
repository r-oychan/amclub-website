{
  "kind": "collectionType",
  "collectionName": "fitness_facilities",
  "info": {
    "singularName": "fitness-facility",
    "pluralName": "fitness-facilities",
    "displayName": "Fitness: Facilities",
    "description": "Fitness section detail pages: gym, aquatics, tennis, squash, pilates, sên Spa, etc. Self-relation `parent` lets nested programs (e.g. aquatics → swimamerica) live as child entries. Team grid is sourced from the per-discipline coach collections (aquatics-coach, tennis-coach, pilates-instructor, gym-trainer) — not a relation here, looked up by slug at render time."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "heroVideo": {
      "type": "string"
    },
    "parentLabel": {
      "type": "string"
    },
    "parentHref": {
      "type": "string"
    },
    "locationLevel": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "dressCode": {
      "type": "string"
    },
    "operatingHoursSections": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.operating-hours-section"
    },
    "extraSections": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.extra-section"
    },
    "locationContact": {
      "type": "component",
      "repeatable": false,
      "component": "blocks.location-contact"
    },
    "ctas": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link",
      "max": 4
    },
    "bottomCtas": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link",
      "max": 4
    },
    "downloads": {
      "type": "component",
      "repeatable": false,
      "component": "blocks.downloads-section"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "blocks.text-block",
        "blocks.card-grid",
        "blocks.feature-grid",
        "blocks.three-col-grid",
        "blocks.cta-banner",
        "blocks.faq-section",
        "blocks.downloads-section",
        "blocks.tabs-section",
        "blocks.image-panel-slideshow",
        "blocks.priced-card-grid",
        "blocks.quotes-block",
        "blocks.collage-gallery"
      ]
    },
    "imagePanels": {
      "type": "component",
      "repeatable": true,
      "component": "shared.image-text-panel"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::fitness-facility.fitness-facility",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::fitness-facility.fitness-facility",
      "mappedBy": "parent"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
