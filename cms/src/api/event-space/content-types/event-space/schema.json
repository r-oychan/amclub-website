{
  "kind": "collectionType",
  "collectionName": "event_spaces",
  "info": {
    "singularName": "event-space",
    "pluralName": "event-spaces",
    "displayName": "Event Space",
    "description": "Event-spaces detail pages — venues (Galbraith Ballroom, Thinkspace, Bowling Alley, Library, Meeting Rooms) and package pages (Wedding Celebrations, Corporate Functions, Parties)."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "description": { "type": "text" },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "heroVideo": { "type": "string" },
    "parentLabel": { "type": "string" },
    "parentHref": { "type": "string" },
    "capacity": { "type": "string" },
    "locationLevel": { "type": "string" },
    "phone": { "type": "string" },
    "email": { "type": "email" },
    "operatingHoursSections": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.operating-hours-section"
    },
    "extraSections": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.extra-section"
    },
    "locationContact": {
      "type": "component",
      "repeatable": false,
      "component": "blocks.location-contact"
    },
    "ctas": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link",
      "max": 4
    },
    "bottomCtas": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link",
      "max": 4
    },
    "downloads": {
      "type": "component",
      "repeatable": false,
      "component": "blocks.downloads-section"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "venueCards": {
      "type": "component",
      "repeatable": false,
      "component": "blocks.venue-card-grid"
    },
    "packageCards": {
      "type": "component",
      "repeatable": false,
      "component": "blocks.package-card-grid"
    },
    "order": { "type": "integer", "default": 0 },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
